# Step Challenge App - Environment Variables Template
# Copy this file to .env and update with your actual values

# Production environment
NODE_ENV=production

# Session Security - CRITICAL: Generate a strong random secret for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secure-random-session-secret-here-replace-this

# Mailgun Configuration for email sending
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=your-domain.com
FROM_EMAIL=noreply@your-domain.com

# Server Configuration
PORT=3000
# Canonical origin used for production magic links. Required in production;
# never derive authentication links from request Host headers.
PUBLIC_BASE_URL=https://steps.example.com

# Trotter constrained chat beta (disabled unless explicitly enabled)
CHAT_ENABLED=false
# legacy = current intent/voice pipeline; tools = bounded native function calling
CHAT_AGENT_MODE=legacy
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# Production gate: confirm this key uses a billed Gemini API project whose
# prompts are handled under Google's Paid Services data terms.
GEMINI_PAID_SERVICE_ACKNOWLEDGED=false
CHAT_API_LIMIT_MAX=30
CHAT_GLOBAL_HOURLY_LIMIT_MAX=500
CHAT_GLOBAL_DAILY_LIMIT_MAX=2500
CHAT_IMAGE_LIMIT_MAX=10
CHAT_IMAGE_GLOBAL_LIMIT_MAX=100

# Database Configuration (SQLite paths are handled automatically based on NODE_ENV)
# Production: /data/steps.db (mounted volume)
# Development: ./steps.db (local file)